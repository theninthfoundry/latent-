# LATENT Digital Studio — Environment Configuration Template
# Copy this file to .env.local for local development. NEVER commit secret keys to version control.

# Site URL for canonical metadata and OpenGraph resolution
NEXT_PUBLIC_SITE_URL=https://latent.studio

# API Rate Limiting (Inquiry Route)
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=60

# Optional Webhook for Studio Inquiries (e.g., Slack / Discord / Internal Dispatch)
# INQUIRY_NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/services/xxx

# Environment Identifier (development | staging | production)
APP_ENV=development
